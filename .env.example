# ============================================================
# KazGaza — environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=kazgaza
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=kazgaza

# Used by the backend outside Docker Compose (e.g. running alembic locally).
# Inside Docker Compose this is overridden to point at the postgres service.
DATABASE_URL=postgresql+asyncpg://kazgaza:change-me-strong-password@localhost:5432/kazgaza

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Backend / API ----
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ENV=production
DEBUG=false
COOKIE_SECURE=true
COOKIE_DOMAIN=
CORS_ORIGINS=https://your-domain.kz

UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_MB=10
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp
PUBLIC_MEDIA_BASE_URL=/media

RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_BOT=60/minute

# ---- Telegram Bot ----
# Obtain from @BotFather — see README "Creating a Telegram Bot".
BOT_TOKEN=123456789:AAExampleTelegramBotTokenReplaceMe

# Shared secret between the bot service and backend's /bot/* endpoints.
# Generate with: openssl rand -hex 32
BOT_INTERNAL_TOKEN=change-me-shared-bot-secret

# ---- Frontend (admin-web) ----
# These are baked in at BUILD time (Next.js NEXT_PUBLIC_* vars), so set
# them before running `docker compose build frontend`.
NEXT_PUBLIC_API_URL=https://your-domain.kz/api/v1
NEXT_PUBLIC_WS_URL=wss://your-domain.kz
NEXT_PUBLIC_MEDIA_URL=https://your-domain.kz
